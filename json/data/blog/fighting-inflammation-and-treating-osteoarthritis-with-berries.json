{
  "Title": "Fighting Inflammation and Treating Osteoarthritis with Berries",
  "Url": "https://nutritionfacts.org/blog/fighting-inflammation-and-treating-osteoarthritis-with-berries/",
  "UpdatedAt": "2023-09-19T12:00:20+00:00",
  "Author": "Michael Greger M.D. FACLM",
